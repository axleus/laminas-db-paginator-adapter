{
    "name": "phpdb/phpdb-paginator-adapter",
    "description": "phpdb adapters for laminas-paginator.",
    "license": "BSD-3-Clause",
    "keywords": [
        "laminas",
        "mezzio",
        "phpdb",
        "pagination",
        "db"
    ],
    "homepage": "https://github.com/php-db/phpdb-paginator-adapter/discussions",
    "support": {
        "issues": "https://github.com/php-db/phpdb-paginator-adapter/issues",
        "source": "https://github.com/php-db/phpdb-paginator-adapter",
        "forum": "https://github.com/php-db/phpdb-paginator-adapter/discussions"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.99"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "laminas/laminas-paginator": "^2.20.0 || ^3.0.0",
        "php-db/phpdb": "^0.6.0"
    },
    "require-dev": {
        "laminas/laminas-coding-standard": "^3.0.1",
        "phpunit/phpunit": "^10.5.0"
    },
    "suggest": {
        "phpdb/phpdb-servicemanager": "Laminas\\ServiceManager component"
    },
    "autoload": {
        "psr-4": {
            "PhpDb\\Paginator\\Adapter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpDbTest\\Paginator\\Adapter\\": "test/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "test": "phpunit --colors=always --testsuite \"unit test\"",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "test-integration": "phpunit --colors=always --testsuite \"integration test\"",
        "static-analysis": "mago analyze",
        "upload-coverage": "coveralls -v"
    }
}